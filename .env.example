# Only API keys and tokens belong here.
# All runtime settings live in config/app.json.

# Telegram bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LP auto-close executor wallet secret key (base58, 64-byte key).
# Leave empty to keep the executor disabled.
LP_EXECUTOR_PRIVATE_KEY=your_base58_secret_key_here

# Required for auto-close swaps via Jupiter Router / tx.jup.ag.
JUPITER_API_KEY=your_jupiter_api_key_here
