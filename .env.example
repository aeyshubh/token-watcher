# GMGN OpenAPI key (apply at https://gmgn.ai/ai)
GMGN_API_KEY=your_gmgn_api_key_here

# Telegram bot + destination chat
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Polling / alerting
POLL_INTERVAL_MS=15000
PING_COUNT=5
PING_DELAY_MS=1000

# Position analysis (/pos command)
# Public RPC works but a dedicated (Helius/QuickNode) RPC is faster for the on-chain LP scan.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
POS_TOP_WALLETS=15

# HawkFi pool scout (runs in-process with the price bot; set SCOUT_ENABLED=false to disable)
SCOUT_ENABLED=true
SCOUT_INTERVAL_MS=15000
SCOUT_MIN_MARKET_CAP=1000000
SCOUT_MIN_FEES_1H=2000
SCOUT_MIN_TVL=50000
SCOUT_MIN_VOLUME_30M=100000
# Minimum ms between repeat alerts for the same pool. 60000 = re-alert after 1 min.
SCOUT_MIN_ALERT_INTERVAL_MS=60000
SCOUT_MAX_RESULTS=100
