{
  "name": "tokenwatcher",
  "version": "1.0.0",
  "private": true,
  "description": "Watches Solana token prices via GMGN OpenAPI and alerts on Telegram when target levels are hit.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "get-chat-id": "tsx scripts/get-chat-id.ts",
    "test-alert": "tsx scripts/test-alert.ts",
    "test-pos": "tsx scripts/test-pos.ts",
    "set-commands": "tsx scripts/set-commands.ts",
    "reset": "tsx scripts/reset-state.ts",
    "reset-scout": "tsx scripts/reset-scout.ts",
    "scout": "tsx src/scout.ts",
    "test-scout": "tsx scripts/test-scout.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
