{
  "name": "tokenwatcher",
  "version": "1.0.0",
  "private": true,
  "description": "Tracks Meteora DLMM LP positions and auto-closes them on TP/SL via Telegram.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "get-chat-id": "tsx scripts/get-chat-id.ts",
    "set-commands": "tsx scripts/set-commands.ts",
    "test-lp": "tsx scripts/test-lp.ts",
    "test-close": "tsx scripts/test-close.ts",
    "reset-lp": "tsx scripts/reset-lp.ts"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.9.14",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
